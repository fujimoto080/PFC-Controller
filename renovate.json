{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "semanticCommitType": "依存",
  "semanticCommitScope": "deps",
  "ignorePaths": ["twa/**", "**/node_modules/**"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "packageRules": [
    {
      "description": "devDependencies の patch/minor は CI 通過で自動マージ",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "devDependencies (non-major)",
      "automerge": true
    },
    {
      "description": "本番 dependencies の patch/minor はまとめて手動レビュー",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "dependencies (non-major)"
    },
    {
      "description": "Radix UI 群はまとめて 1 PR に",
      "matchPackageNames": ["@radix-ui/**"],
      "groupName": "Radix UI"
    },
    {
      "description": "GitHub Actions はまとめて自動マージ",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "automerge": true
    }
  ]
}
